# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Hugging Face token (read scope). Needed to download the gated Llama weights
# on the GPU box in Stage 2 / Stage 4. Get it after your access request for
# meta-llama/Llama-3.1-8B-Instruct is approved.
HF_TOKEN=

# OpenAI API key. Used by promptfoo as the GPT-4o judge (llm-rubric) and for the
# free moderation assertion in Stage 2, and for grading in Stage 5.
OPENAI_API_KEY=

# The bearer token you pass to `vllm serve --api-key` on the GPU box, and that
# promptfoo sends as the provider apiKey. Any random string; keep it secret.
VLLM_API_KEY=token-please-change-me

# Base URL of the vLLM OpenAI-compatible server (set in Stage 2 once the GPU box
# is up). Example: http://127.0.0.1:8000/v1 over an SSH tunnel, or the pod's
# public URL. Must end in /v1.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
